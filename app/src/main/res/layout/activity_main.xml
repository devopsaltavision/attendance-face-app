<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attendanceHomeRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/attendance_ready_background" android:padding="28dp">
    <ImageView android:id="@+id/homeIcon" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@string/attendance_title" android:src="@drawable/ic_home_green" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <TextView android:id="@+id/homeAppTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/attendance_title" android:textColor="@color/attendance_scanning" android:textSize="20sp" android:textStyle="bold" app:layout_constraintStart_toEndOf="@id/homeIcon" app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton android:id="@+id/adminButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/admin_settings" android:src="@android:drawable/ic_menu_preferences" android:tint="@color/attendance_text" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <TextView android:id="@+id/currentTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="44dp" android:textColor="@color/attendance_text" android:textSize="38sp" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/homeAppTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/currentDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/attendance_text_secondary" android:textSize="16sp" app:layout_constraintTop_toBottomOf="@id/currentTime" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/homePrompt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:text="@string/check_in_out_with" android:textColor="@color/attendance_text" android:textSize="21sp" app:layout_constraintTop_toBottomOf="@id/currentDate" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <com.syntaxgenie.hfx05attendance.ui.FingerprintVisualView android:id="@+id/fingerprintVisual" android:layout_width="120dp" android:layout_height="140dp" android:visibility="gone" android:contentDescription="@string/fingerprint_visual_description"/>
    <TextView android:id="@+id/attendanceStatusTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/attendance_text" android:textSize="14sp" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/homePrompt" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/attendanceInstruction" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/attendance_text_secondary" android:textSize="14sp" app:layout_constraintTop_toBottomOf="@id/attendanceStatusTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/attendanceDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/attendance_text" android:textSize="14sp" app:layout_constraintTop_toBottomOf="@id/attendanceInstruction" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/scanFaceButton" android:layout_width="match_parent" android:layout_height="136dp" android:layout_marginTop="28dp" android:background="@drawable/biometric_primary_button" android:gravity="center_vertical|start" android:paddingHorizontal="24dp" android:text="@string/face_recognition" android:textAllCaps="false" android:textColor="@color/white" android:textSize="20sp" app:backgroundTint="@null" app:icon="@drawable/ic_face_recognition" app:iconGravity="textStart" app:iconPadding="20dp" app:iconSize="48dp" app:iconTint="@color/white" app:layout_constraintTop_toBottomOf="@id/attendanceDetail" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/scanFingerprintButton" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone" android:text="@string/fingerprint_scan_action" app:layout_constraintTop_toBottomOf="@id/scanFaceButton" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <LinearLayout android:id="@+id/homeEmulatorControls" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone">
        <Spinner android:id="@+id/homeEmulatorFinger" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <Button android:id="@+id/homeEmulatorCapture" android:layout_width="1dp" android:layout_height="1dp"/>
    </LinearLayout>
    <TextView android:id="@+id/homeSyncStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/attendance_status_card" android:gravity="center" android:padding="12dp" android:text="@string/sync_not_configured" android:textColor="@color/attendance_text_secondary" android:textSize="12sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
