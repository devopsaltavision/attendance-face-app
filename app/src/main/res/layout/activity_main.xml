    <com.google.android.material.button.MaterialButton android:id="@+id/scanFingerprintButton" android:layout_width="match_parent" android:layout_height="136dp" android:layout_marginTop="16dp" android:background="@drawable/biometric_primary_button" android:gravity="center_vertical|start" android:paddingHorizontal="24dp" android:text="@string/fingerprint_scan_action" android:textAllCaps="false" android:textColor="@color/white" android:textSize="20sp" app:backgroundTint="@null" app:icon="@drawable/ic_fingerprint" app:iconGravity="textStart" app:iconPadding="20dp" app:iconSize="48dp" app:iconTint="@color/white" app:layout_constraintTop_toBottomOf="@id/scanFaceButton" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
