<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/userManagementRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/userManagementToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/attendance_surface" app:navigationIcon="?attr/homeAsUpIndicator" app:title="@string/user_management" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:hint="@string/search_users" app:startIconDrawable="@android:drawable/ic_menu_search">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/userSearchInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/syncUsersButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="@string/sync_users" />
        <com.google.android.material.button.MaterialButton android:id="@+id/fullRefreshButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:layout_weight="1" android:text="@string/full_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/userSyncStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:textColor="@color/attendance_text_secondary" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/employeeRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/emptyUsersText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="32dp" android:text="@string/no_users_synced" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
