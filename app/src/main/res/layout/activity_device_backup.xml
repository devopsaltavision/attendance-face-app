<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deviceBackupRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/deviceBackupToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/attendance_surface" app:navigationIcon="?attr/homeAsUpIndicator" app:title="@string/device_backup_title" app:titleTextColor="@color/attendance_text" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/deviceBackupStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/device_backup_ready" android:textAppearance="?attr/textAppearanceTitleMedium" />
        <TextView android:id="@+id/deviceBackupFingerprint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/device_backup_fingerprint_unknown" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView android:id="@+id/deviceBackupFace" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/device_backup_face_unknown" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView android:id="@+id/deviceBackupLastSuccess" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/device_backup_last_never" />
        <com.google.android.material.button.MaterialButton android:id="@+id/backupNowButton" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="32dp" android:text="@string/backup_now" />
        <com.google.android.material.button.MaterialButton android:id="@+id/restoreDeviceDataButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:text="@string/restore_device_data" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deleteCloudBackupButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:text="@string/delete_cloud_backup" />
    </LinearLayout>
</LinearLayout>
