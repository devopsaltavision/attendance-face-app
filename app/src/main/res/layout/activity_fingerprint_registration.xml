<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/registrationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/registrationToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/attendance_surface"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/fingerprint_registration"
        app:titleTextColor="@color/attendance_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/employee"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/attendance_text_secondary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/missingEmployeeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/attendance_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/attendance_warning"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_employee_selected"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/attendance_warning" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/select_employee_before_registration"
                        android:textColor="@color/attendance_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backToUserManagementButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/back_to_user_management" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/debugPreviewRegistrationButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/debug_preview_registration"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/registrationEnrollmentContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/selectedEmployeeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/attendance_surface"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView android:id="@+id/selectedEmployeeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                        <TextView android:id="@+id/selectedEmployeeId" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/attendance_text_secondary" />
                        <TextView android:id="@+id/selectedEmployeeUserId" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/attendance_text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/debugPreviewLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/debug_preview_identity"
                    android:textColor="@color/attendance_warning"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/registrationFingerField"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/finger"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/registrationFingerDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.syntaxgenie.hfx05attendance.ui.FingerprintVisualView android:id="@+id/registrationFingerprintVisual" android:layout_width="185dp" android:layout_height="220dp" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" android:contentDescription="@string/fingerprint_visual_description" />
                <TextView android:id="@+id/registrationProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/capture_zero_of_five" android:textAppearance="@style/TextAppearance.Material3.TitleLarge" android:textStyle="bold" />
                <TextView android:id="@+id/registrationGuidance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="@string/capture_guidance_first" android:textColor="@color/attendance_text_secondary" />
                <LinearLayout android:id="@+id/registrationDots" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal" />
                <TextView android:id="@+id/registrationDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" />
                <com.google.android.material.button.MaterialButton android:id="@+id/registrationStartButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="@string/start_enrollment" />
                <com.google.android.material.button.MaterialButton android:id="@+id/registrationCaptureButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="@string/capture_next" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/registrationCancelButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="4dp" android:text="@string/cancel_enrollment" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/registrationDoneButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/done" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
