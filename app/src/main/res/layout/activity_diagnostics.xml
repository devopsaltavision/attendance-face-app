<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/diagnosticsRoot"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/diagnosticsToolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="@color/attendance_surface" app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/diagnostics_title" app:titleTextColor="@color/attendance_text" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:background="@drawable/fingerprint_scan_area" android:padding="12dp" />
            <Button android:id="@+id/runFullDiagnosticsButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/run_full_diagnostics" />
            <Button android:id="@+id/activeSensorProbeButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="@string/active_sensor_probe" />
            <Button android:id="@+id/realCaptureButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="@string/legacy_raw_capture" />
            <Button android:id="@+id/scannerLayerCaptureButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="@string/scanner_layer_capture" />
            <Button android:id="@+id/identificationCalibrationButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="@string/identification_score_calibration" android:visibility="gone" />
            <Button android:id="@+id/viewLastCaptureButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/view_last_capture" />
            <ImageView android:id="@+id/capturePreview" android:layout_width="256dp" android:layout_height="360dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:contentDescription="@string/capture_preview" android:scaleType="fitCenter" android:visibility="gone" />
            <Button android:id="@+id/copyDiagnosticsButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:enabled="false" android:text="@string/copy_complete_report" />
            <TextView android:id="@+id/diagnosticText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="monospace" android:textIsSelectable="true" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
