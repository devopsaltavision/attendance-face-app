<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/faceScanRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/attendance_ready_background" android:padding="16dp">
    <com.google.android.material.button.MaterialButton android:id="@+id/faceScanCancel" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back" android:insetLeft="0dp" android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="12dp" android:text="" app:backgroundTint="@null" app:icon="@drawable/ic_arrow_back_green" app:iconTint="@color/attendance_scanning" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <TextView android:id="@+id/faceScanHeaderTitle" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:text="@string/face_recognition" android:textColor="@color/attendance_text" android:textSize="20sp" android:textStyle="bold" app:layout_constraintStart_toEndOf="@id/faceScanCancel" app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout android:id="@+id/faceScanPreviewContainer" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="14dp" android:background="@drawable/biometric_surface_card" android:clipToOutline="true" app:layout_constraintTop_toBottomOf="@id/faceScanCancel" app:layout_constraintBottom_toTopOf="@id/faceScanStatusCard" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <SurfaceView android:id="@+id/faceScanPreview" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <com.syntaxgenie.hfx05attendance.face.scan.FaceScanOverlayView android:id="@+id/faceScanOverlay" android:layout_width="match_parent" android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout android:id="@+id/faceScanStatusCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/biometric_surface_card" android:orientation="vertical" android:padding="16dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/faceScanTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Position your face inside the frame" android:textColor="@color/attendance_scanning" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/faceScanStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Look straight at the camera" android:textColor="@color/attendance_text" android:textSize="15sp"/>
        <TextView android:id="@+id/faceScanValidationStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
