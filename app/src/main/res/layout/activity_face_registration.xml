<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/faceRegistrationRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/attendance_ready_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageButton android:id="@+id/registrationBack" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_arrow_back_green" android:contentDescription="Back" android:padding="12dp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Register Face" android:textSize="20sp" android:textStyle="bold"/></LinearLayout>
 <TextView android:id="@+id/registrationEmployee" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="6dp" android:textSize="21sp" android:textStyle="bold"/>
 <TextView android:id="@+id/registrationEmployeeNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingBottom="8dp" android:textSize="36sp" android:textStyle="bold"/>
 <TextView android:id="@+id/registrationSuccessTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="8dp" android:text="Face Registered" android:textSize="24sp" android:textStyle="bold" android:visibility="gone"/>
 <TextView android:id="@+id/registrationProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="1 of 3" android:textSize="22sp" android:textStyle="bold" android:padding="4dp"/>
 <TextView android:id="@+id/registrationInstruction" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="LOOK STRAIGHT" android:textStyle="bold" android:textSize="22sp" android:padding="6dp"/>
 <FrameLayout android:id="@+id/registrationPreviewContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <SurfaceView android:id="@+id/registrationPreview" android:layout_width="match_parent" android:layout_height="match_parent"/>
  <com.syntaxgenie.hfx05attendance.face.scan.FaceScanOverlayView android:id="@+id/registrationOverlay" android:layout_width="match_parent" android:layout_height="match_parent"/>
  <ImageView android:id="@+id/registrationCaptured" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="Captured face preview"/>
 </FrameLayout>
 <LinearLayout android:id="@+id/registrationReview" android:layout_width="match_parent" android:layout_height="176dp" android:orientation="horizontal" android:visibility="gone" android:padding="4dp"/>
 <TextView android:id="@+id/registrationStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="Position your face inside the frame" android:textSize="16sp"/>
 <Button android:id="@+id/registrationAddSample" android:layout_width="match_parent" android:layout_height="68dp" android:text="CAPTURE" android:textSize="22sp" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
 <Button android:id="@+id/registrationConfirm" android:layout_width="match_parent" android:layout_height="68dp" android:text="USE PHOTO" android:textSize="22sp" android:textStyle="bold" android:visibility="gone"/>
 <Button android:id="@+id/registrationRetry" android:layout_width="match_parent" android:layout_height="68dp" android:text="RETAKE" android:textSize="22sp" android:textStyle="bold" android:visibility="gone"/>
 <Button android:id="@+id/registrationDone" android:layout_width="match_parent" android:layout_height="68dp" android:text="DONE" android:textSize="22sp" android:textStyle="bold" android:visibility="gone"/>
</LinearLayout>
