<resources>
    <style name="Base.Theme.HFX05Attendance" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/attendance_scanning</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/attendance_surface</item>
        <item name="colorOnSurface">@color/attendance_text</item>
        <item name="android:colorBackground">@color/attendance_ready_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/kiosk_system_bar</item>
        <item name="android:navigationBarColor">@color/kiosk_system_bar</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="toolbarStyle">@style/Widget.SlhFp.Toolbar</item>
    </style>

    <style name="Widget.SlhFp.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:minHeight">?attr/actionBarSize</item>
        <item name="android:background">@color/attendance_surface</item>
        <item name="titleTextColor">@color/attendance_text</item>
        <item name="subtitleTextColor">@color/attendance_text_secondary</item>
    </style>

    <style name="Theme.HFX05Attendance" parent="Base.Theme.HFX05Attendance" />
</resources>
